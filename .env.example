# ==========================================
# Airflow Environment Variables
# ==========================================
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_SECRET_KEY=generate_with_openssl_rand_hex_32
AIRFLOW__CORE__LOAD_EXAMPLES=false
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ==========================================
# PostgreSQL Database Credentials
# ==========================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ==========================================
# Object Storage (AWS S3 / MinIO Emulator)
# ==========================================
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=raw-data
AWS_DEFAULT_REGION=us-east-1

# ==========================================
# Snowflake Connection Credentials
# ==========================================
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_PASSWORD=YourStrongPassword123!
SNOWFLAKE_ROLE=DATA_ENGINEER
SNOWFLAKE_DATABASE=ENTERPRISE_MDS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=RAW

# ==========================================
# Observability & Monitoring
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# Alert Webhooks & Notification Callbacks
# ==========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
